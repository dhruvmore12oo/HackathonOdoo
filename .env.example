# ====================================================
# Traveloop — Root Environment Configuration
# ====================================================
# Copy this file to .env and fill in the values.

# ── PostgreSQL ──
POSTGRES_USER=traveloop_user
POSTGRES_PASSWORD=traveloop_secret_change_me
POSTGRES_DB=traveloop_db
POSTGRES_PORT=5432

# ── Backend ──
BACKEND_PORT=4000
NODE_ENV=development
JWT_SECRET=any_long_string
JWT_REFRESH_SECRET=any_long_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://traveloop_user:traveloop_secret_change_me@postgres:5432/traveloop_db

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Traveloop

# ── File Uploads ──
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
